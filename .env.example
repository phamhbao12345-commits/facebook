# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG MẪU CHO FB-GROUP-AUTOPOSTER
# Sao chép file này thành .env và điền các giá trị thực tế trước khi chạy.
# ==============================================================================

# Chế độ chạy thử nghiệm (true: dùng Mock Server nội bộ, false: chạy trực tiếp trên Facebook thật)
MOCK_MODE=true

# Chế độ hiển thị cửa sổ Chrome (false: bật cửa sổ lên màn hình để coi trực tiếp, true: chạy ngầm không hiện cửa sổ)
HEADLESS=false

# Cổng lắng nghe cho Mock Server nội bộ
PORT=3000

# Khóa API Google Gemini (sử dụng model gemini-2.5-flash để tự sửa lỗi selector)
GEMINI_API_KEY=

# Cấu hình thông báo Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ID Nhóm Facebook mục tiêu để đăng bài
FB_GROUP_ID=123456789

# Chuỗi Cookie Facebook (dạng JSON string danh sách cookie để tự động đăng nhập không cần mở tay)
FB_COOKIES_JSON=

# (Tùy chọn) Đường dẫn tới Google Chrome thực tế nếu muốn chỉ định thủ công
# Hệ thống đã tự động tìm Chrome trên máy bạn, chỉ điền nếu dùng vị trí khác:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
